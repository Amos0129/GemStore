// 完整的電商後台管理系統 Prisma Schema
// 根據後台功能需求設計的正規化資料庫結構

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================================
// 核心用戶與權限管理
// ================================

// 用戶表 - 支援客戶和管理員
model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  firstName            String
  lastName             String
  password             String
  phone                String?
  avatar               String?
  role                 Role      @default(CUSTOMER)
  isActive             Boolean   @default(true)
  emailVerified        Boolean   @default(false)
  emailVerifyToken     String?
  passwordResetToken   String?
  passwordResetExpiry  DateTime?
  lastLoginAt          DateTime?
  membershipLevel      MembershipLevel @default(BRONZE)
  totalSpent           Decimal   @default(0) @db.Decimal(12,2)
  totalOrders          Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // 關聯
  addresses            Address[]
  orders               Order[]
  reviews              Review[]
  wishlist             Wishlist[]
  cart                 CartItem[]
  adminLogs            AdminLog[]
  notifications        UserNotification[]

  @@map("users")
}

enum Role {
  ADMIN
  CUSTOMER
}

enum MembershipLevel {
  BRONZE    // 一般會員
  SILVER    // 銀級會員  
  GOLD      // 金級會員
  PLATINUM  // 白金會員
}

// 管理員操作日誌
model AdminLog {
  id          String    @id @default(cuid())
  userId      String
  action      String    // 操作類型: CREATE, UPDATE, DELETE
  resource    String    // 資源類型: product, order, user, etc.
  resourceId  String?   // 資源ID
  details     Json?     // 操作詳細資訊
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id])

  @@map("admin_logs")
}

// ================================
// 商品管理系統
// ================================

// 分類表 - 支援樹狀結構
model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  code        String    @unique
  description String?
  icon        String?   // 圖示名稱
  image       String?   // 分類圖片
  parentId    String?   // 父分類ID
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // 自關聯
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")

  // 關聯
  products    Product[]

  @@map("categories")
}

// 商品表
model Product {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  sku           String?  @unique
  description   String?
  shortDesc     String?
  price         Decimal  @db.Decimal(12,2)
  originalPrice Decimal? @db.Decimal(12,2)
  cost          Decimal? @db.Decimal(12,2) // 成本價
  stock         Int      @default(0)
  lowStockThreshold Int @default(10)
  weight        Float?
  dimensions    String?
  isActive      Boolean  @default(true)
  isFeatured    Boolean  @default(false)
  badge         String?  // 'new', 'hot', 'sale', 'limited'
  rating        Float    @default(0)
  reviewCount   Int      @default(0)
  salesCount    Int      @default(0)
  views         Int      @default(0)
  metaTitle     String?
  metaDescription String?
  metaKeywords  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // 外鍵
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])

  // 關聯
  images        ProductImage[]
  attributes    ProductAttribute[]
  reviews       Review[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  wishlist      Wishlist[]
  tags          ProductTag[]
  inventory     InventoryLog[]

  @@map("products")
}

// 商品圖片
model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String?
  sortOrder Int     @default(0)
  isMain    Boolean @default(false)
  
  // 外鍵
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

// 商品屬性（顏色、尺寸等）
model Attribute {
  id       String @id @default(cuid())
  name     String @unique
  type     AttributeType
  values   String[] // 可選值陣列
  
  productAttributes ProductAttribute[]

  @@map("attributes")
}

enum AttributeType {
  COLOR
  SIZE
  MATERIAL
  STYLE
  OTHER
}

model ProductAttribute {
  id          String @id @default(cuid())
  value       String
  extraPrice  Decimal? @db.Decimal(10,2) // 額外費用
  
  productId   String
  attributeId String
  
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute   Attribute @relation(fields: [attributeId], references: [id])

  @@unique([productId, attributeId])
  @@map("product_attributes")
}

// 商品標籤
model Tag {
  id       String @id @default(cuid())
  name     String @unique
  color    String @default("#6B7280")
  
  products ProductTag[]

  @@map("tags")
}

model ProductTag {
  productId String
  tagId     String
  
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@map("product_tags")
}

// 庫存記錄
model InventoryLog {
  id          String    @id @default(cuid())
  type        InventoryType
  quantity    Int       // 正數為入庫，負數為出庫
  reason      String?
  reference   String?   // 關聯的訂單號或其他參考
  createdAt   DateTime  @default(now())

  productId   String
  product     Product   @relation(fields: [productId], references: [id])

  @@map("inventory_logs")
}

enum InventoryType {
  PURCHASE    // 採購入庫
  SALE        // 銷售出庫
  RETURN      // 退貨入庫
  ADJUSTMENT  // 庫存調整
  DAMAGE      // 損壞
}

// ================================
// 訂單管理系統
// ================================

// 地址表
model Address {
  id         String  @id @default(cuid())
  type       AddressType @default(SHIPPING)
  name       String  // 收件人姓名
  phone      String
  country    String  @default("Taiwan")
  city       String
  district   String?
  address    String
  postalCode String
  isDefault  Boolean @default(false)
  
  // 外鍵
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 關聯
  orders     Order[]

  @@map("addresses")
}

enum AddressType {
  SHIPPING  // 收貨地址
  BILLING   // 帳單地址
}

// 訂單表
model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  status         OrderStatus @default(PENDING)
  subtotal       Decimal     @db.Decimal(12,2)
  shippingFee    Decimal     @default(0) @db.Decimal(10,2)
  tax            Decimal     @default(0) @db.Decimal(10,2)
  discount       Decimal     @default(0) @db.Decimal(10,2)
  totalAmount    Decimal     @db.Decimal(12,2)
  currency       String      @default("TWD")
  paymentMethod  PaymentMethod?
  paymentStatus  PaymentStatus @default(PENDING)
  shippingMethod String?
  trackingNumber String?
  notes          String?
  paidAt         DateTime?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  cancelledAt    DateTime?
  cancellationReason String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // 外鍵
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  shippingAddressId String
  shippingAddress Address   @relation(fields: [shippingAddressId], references: [id])

  // 關聯
  items          OrderItem[]
  statusHistory  OrderStatusHistory[]

  @@map("orders")
}

enum OrderStatus {
  PENDING     // 待付款
  PAID        // 已付款
  PROCESSING  // 處理中
  SHIPPED     // 已出貨
  DELIVERED   // 已送達
  CANCELLED   // 已取消
  REFUNDED    // 已退款
}

enum PaymentMethod {
  CREDIT_CARD    // 信用卡
  BANK_TRANSFER  // 銀行轉帳
  LINE_PAY       // Line Pay
  APPLE_PAY      // Apple Pay
  PAYPAL         // PayPal
  CASH_ON_DELIVERY // 貨到付款
}

enum PaymentStatus {
  PENDING    // 待付款
  COMPLETED  // 已完成
  FAILED     // 失敗
  CANCELLED  // 已取消
  REFUNDED   // 已退款
}

// 訂單項目
model OrderItem {
  id       String  @id @default(cuid())
  quantity Int
  price    Decimal @db.Decimal(12,2) // 下單時的價格
  total    Decimal @db.Decimal(12,2)
  
  // 外鍵
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

// 訂單狀態歷史
model OrderStatusHistory {
  id        String      @id @default(cuid())
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_status_history")
}

// ================================
// 購物車系統
// ================================

model CartItem {
  id       String   @id @default(cuid())
  quantity Int
  addedAt  DateTime @default(now())
  
  // 外鍵
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("cart_items")
}

// ================================
// 收藏與評價系統
// ================================

// 收藏清單
model Wishlist {
  id      String   @id @default(cuid())
  addedAt DateTime @default(now())
  
  // 外鍵
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist")
}

// 商品評價
model Review {
  id        String   @id @default(cuid())
  rating    Int      // 1-5 星評
  title     String?
  content   String?
  images    String[] // 圖片URL陣列
  isVisible Boolean  @default(true)
  adminReply String? // 管理員回復
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 外鍵
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId]) // 每個用戶對每個商品只能評價一次
  @@map("reviews")
}

// ================================
// 系統設定與通知
// ================================

// 系統設定
model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  type        SettingType
  description String?
  category    String   @default("general")
  isPublic    Boolean  @default(false) // 是否對前端公開
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
  TEXT
}

// 通知系統
model Notification {
  id        String   @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  // 關聯用戶通知
  users     UserNotification[]

  @@map("notifications")
}

enum NotificationType {
  ORDER_CREATED
  ORDER_UPDATED
  ORDER_SHIPPED
  ORDER_DELIVERED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  LOW_STOCK
  NEW_REVIEW
  SYSTEM_ALERT
}

model UserNotification {
  id       String  @id @default(cuid())
  isRead   Boolean @default(false)
  readAt   DateTime?

  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId])
  @@map("user_notifications")
}

// ================================
// 財務與統計
// ================================

// 財務記錄
model FinanceRecord {
  id          String        @id @default(cuid())
  type        FinanceType
  category    String
  amount      Decimal       @db.Decimal(12,2)
  description String?
  reference   String?       // 關聯的訂單號或發票號
  date        DateTime      @default(now())
  createdAt   DateTime      @default(now())

  @@map("finance_records")
}

enum FinanceType {
  INCOME      // 收入
  EXPENSE     // 支出
  REFUND      // 退款
}

// 每日統計
model DailyStat {
  id            String   @id @default(cuid())
  date          DateTime @unique @db.Date
  revenue       Decimal  @default(0) @db.Decimal(12,2)
  orders        Int      @default(0)
  customers     Int      @default(0)
  newCustomers  Int      @default(0)
  productViews  Int      @default(0)
  createdAt     DateTime @default(now())

  @@map("daily_stats")
}

// ================================
// 營銷與促銷
// ================================

// 優惠券
model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  name        String
  description String?
  type        CouponType
  value       Decimal    @db.Decimal(10,2)
  minAmount   Decimal?   @db.Decimal(12,2)
  maxDiscount Decimal?   @db.Decimal(12,2)
  usageLimit  Int?
  usedCount   Int        @default(0)
  isActive    Boolean    @default(true)
  validFrom   DateTime
  validTo     DateTime
  createdAt   DateTime   @default(now())

  @@map("coupons")
}

enum CouponType {
  FIXED       // 固定金額
  PERCENTAGE  // 百分比折扣
}

// ================================
// SEO與內容管理
// ================================

// 網站頁面
model Page {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String
  metaTitle   String?
  metaDescription String?
  metaKeywords String?
  isPublished Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("pages")
}

// ================================
// 檔案管理
// ================================

model MediaFile {
  id        String    @id @default(cuid())
  filename  String
  originalName String
  mimeType  String
  size      Int
  url       String
  path      String
  category  MediaCategory @default(OTHER)
  createdAt DateTime  @default(now())

  @@map("media_files")
}

enum MediaCategory {
  PRODUCT_IMAGE
  CATEGORY_IMAGE
  AVATAR
  BANNER
  LOGO
  OTHER
}